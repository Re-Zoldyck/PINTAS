{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/_api/:route*", "destination": "/api/index?route=:route*" },
    { "source": "/((?!api/|_api/|assets/).*)", "destination": "/index.html" }
  ]
}
