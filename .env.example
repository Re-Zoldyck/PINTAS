# Koneksi PostgreSQL (Neon / Vercel Postgres / Supabase). Sertakan ?sslmode=require bila perlu.
DATABASE_URL=postgresql://user:password@host/pintas?sslmode=require
# Rahasia penandatangan cookie sesi (JWT). Buat: openssl rand -hex 32
JWT_SECRET=ganti-dengan-string-acak-panjang
# Token Vercel Blob (Storage → Blob → Create store → .env.local / Environment Variables)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx
